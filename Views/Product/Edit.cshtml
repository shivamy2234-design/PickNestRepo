@model ProductDto
<div class="row">
    <div class="col-sm-8 mx-auto rounded-1 border-2 p-3">
        <h2 class="text-center mb-5">Edit Product</h2>
        <hr />
        <form method="post" enctype="multipart/form-data" asp-controller="Product" asp-action="Edit">
            <div class="row mb-3">
                <div class="col-sm-4">
                    <label asp-for="Name">Name</label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4">
                    <label asp-for="Brand">Brand</label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Brand" class="form-control" placeholder="Enter product Brand" />
                    <span asp-validation-for="Brand" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4">
                    <label asp-for="Category">Category</label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="Category" class="form-control">
                        <option value="Other">Other</option>
                        <option value="Phone">Phone</option>
                        <option value="Laptop">Laptop</option>
                        <option value="Printer">Printer</option>
                    </select>
                  </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4">
                    <label asp-for="Price">Price</label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Price" class="form-control" placeholder="Enter product Price" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4">
                    <label asp-for="Description">Description</label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Description" class="form-control" placeholder="Enter product Description" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4">
                    <label asp-for="ImageFileName">ImageFileName</label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="ImageFileName" type="file" class="form-control" placeholder="Enter product ImageFileName" />
                    <span asp-validation-for="ImageFileName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-8">
                    <button type="submit" class="btn btn-success">Edit</button>
                    <a asp-action="index" asp-controller="Product" class="btn btn-outline-danger">Cancel</a>
                </div>
            </div>
        </form>
    </div>

</div>
